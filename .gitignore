# secrets — 由首次安装写入本地，仓库只保留 .env.example
.env
**/.env

# dependencies
node_modules/
apps/**/node_modules/
# 证件二维码内置库（随仓库发布，不要忽略）
!apps/portal/lib/vendor/
!apps/portal/lib/vendor/**
!apps/portal/lib/vendor/qrcode/node_modules/
!apps/portal/lib/vendor/qrcode/node_modules/**

# 安装完成后的锁（空模板仓库不要带 lock）
apps/_shared/data/install.lock

# 本地系统设置（含组织名/域名等业务信息；正式配置在数据库里）
apps/_shared/data/system-settings.json

# logs & runtime
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# uploads / generated
apps/portal/certificates/*
!apps/portal/certificates/.gitkeep
apps/portal/avatars/*
!apps/portal/avatars/.gitkeep
apps/rtls/uploads/*
!apps/rtls/uploads/.gitkeep

# editor / OS
.idea/
.vscode/
*.swp
*.tmp
_audit_tmp.js

# backups (local only)
*_backup_*/
