<%- include('partials/header') %>
<style>
    .settings-wrap { flex:1; width:100%; max-width:none; margin:0; padding:12px 14px 16px; box-sizing:border-box; background: var(--pt-bg, #dfe3e8); }
    .settings-layout { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 12px; align-items: start; }
    .settings-tabs {
        background: var(--pt-panel, #fff); border: 1px solid var(--pt-border-soft, #b9c1ca); border-radius: 0;
        box-shadow: none; padding: 0; position: sticky; top: 10px;
    }
    .settings-tab {
        display: block; width: 100%; text-align: left; border: 0; border-bottom: 1px solid var(--pt-border, #d6dae0);
        background: transparent; border-radius: 0; padding: 10px 12px; margin: 0;
        font-size: 13px; font-weight: 700; color: var(--pt-text-2, #445); cursor: pointer; font-family: inherit;
    }
    .settings-tab:last-child { border-bottom: 0; }
    .settings-tab:hover { background: var(--pt-hover, #eef2f7); }
    .settings-tab.active { background: var(--pt-header, #0056b3); color: #fff; border-color: var(--pt-header, #0056b3); }
    .settings-tab small { display: block; font-size: 11px; font-weight: 500; color: var(--pt-muted, #888); margin-top: 2px; }
    .settings-tab.active small { color: #dbe8f8; }
    .settings-panel { display: none; }
    .settings-panel.active { display: block; }
    .settings-card { background: var(--pt-panel, #fff); border: 1px solid var(--pt-border-soft, #b9c1ca); border-radius: 0; box-shadow: none; padding: 16px; }
    .settings-card h3 { margin: 0 0 6px; padding-bottom: 8px; border-bottom: 1px solid var(--pt-border, #c2c8d0); color: var(--pt-text, #1f3a63); font-size: 16px; }
    .settings-card .cat-desc { margin: 8px 0 14px; color: var(--pt-muted, #777); font-size: 12px; }
    .subtabs { display: flex; flex-wrap: wrap; gap: 0; margin-bottom: 14px; border-bottom: 1px solid var(--pt-border-soft, #b9c1ca); }
    .subtab {
        border: 1px solid transparent; border-bottom: 0; background: transparent; color: var(--pt-text-2, #445); border-radius: 0;
        padding: 7px 13px; font-size: 12px; font-weight: 700; cursor: pointer; font-family: inherit;
    }
    .subtab:hover { background: var(--pt-hover, #eef2f7); }
    .subtab.active { background: var(--pt-header, #0056b3); border-color: var(--pt-header, #0056b3); color: #fff; }
    .settings-section { display: none; margin-top: 4px; }
    .settings-section.active { display: block; }
    .settings-section h4 { margin: 0 0 6px; font-size: 14px; color: var(--pt-text, #222); }
    .settings-section .sec-desc { margin: 0 0 12px; color: var(--pt-muted, #888); font-size: 12px; line-height: 1.5; }
    .sla-group { background: var(--pt-panel-2, #f8fafc); border: 1px solid var(--pt-border, #e8eef5); border-radius: 0; padding: 12px 14px; margin-bottom: 10px; }
    .sla-group h5 { margin: 0 0 10px; font-size: 13px; color: var(--pt-text, #0056b3); }
    .sla-rows { display: flex; flex-direction: column; gap: 8px; }
    .sla-row { display: grid; grid-template-columns: 80px 1fr 1fr 1fr; gap: 8px; align-items: end; }
    .sla-row .prio-label { font-size: 13px; font-weight: 700; color: var(--pt-text-2, #444); padding-bottom: 8px; }
    .field { margin-bottom: 14px; }
    .field.compact { margin-bottom: 0; }
    .field label { display: block; font-size: 12px; font-weight: 600; color: var(--pt-muted, #666); margin-bottom: 4px; }
    .field input, .field textarea, .field select {
        width: 100%; box-sizing: border-box; padding: 7px 9px; border: 1px solid var(--pt-border-soft, #8a8a8a);
        border-radius: 0; font-size: 13px; outline: none; background: var(--pt-input-bg, #fff); color: var(--pt-text, #1a1a1a); font-family: inherit;
    }
    .field input:focus, .field textarea:focus, .field select:focus { outline: 1px solid var(--pt-header, #0056b3); }
    .field-with-unit { position: relative; }
    .field-with-unit input { padding-right: 42px; }
    .field-with-unit .unit {
        position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
        font-size: 12px; color: var(--pt-muted, #999); pointer-events: none;
    }
    .settings-actions {
        display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-top: 14px;
        background: var(--pt-panel-2, #f4f5f7); border: 1px solid var(--pt-border-soft, #b9c1ca); border-radius: 0; padding: 12px 14px; box-shadow: none;
    }
    .settings-actions .btn-save {
        background: var(--pt-header, #0056b3); color: #fff; border: 1px solid var(--pt-header, #0056b3); border-radius: 0;
        padding: 9px 20px; font-size: 14px; font-weight: bold; cursor: pointer; font-family: inherit;
    }
    .settings-actions .btn-save:hover { filter: brightness(1.08); }
    .settings-msg { font-size: 13px; }
    .settings-msg.ok { color: #198754; }
    .settings-msg.err { color: #dc3545; }
    .settings-hint { font-size: 12px; color: var(--pt-muted, #888); margin-top: 10px; line-height: 1.5; }
    .pwa-icon-row { display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap; }
    .pwa-icon-row img {
        width: 96px; height: 96px; object-fit: cover; flex: none;
        border: 1px solid var(--pt-border-soft, #b9c1ca); background: var(--pt-panel-2, #f4f5f7);
    }
    .pwa-icon-side { flex: 1 1 320px; min-width: 260px; }
    .pwa-icon-hint { margin: 0 0 10px; font-size: 12px; color: var(--pt-muted, #888); line-height: 1.6; }
    .pwa-icon-side input[type="file"] { font-size: 13px; margin-bottom: 10px; width: 100%; }
    .pwa-icon-actions { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .pwa-icon-actions button {
        border: 1px solid var(--pt-header, #0056b3); background: var(--pt-header, #0056b3); color: #fff; border-radius: 0;
        padding: 8px 16px; font-size: 13px; font-weight: 700; cursor: pointer; font-family: inherit;
    }
    .pwa-icon-actions button:disabled { opacity: .6; cursor: wait; }
    .nav-editor-toolbar { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
    .nav-editor-toolbar button {
        border: 1px solid var(--pt-border-soft, #8a8a8a); background: var(--pt-panel, #f8fafc); border-radius: 0;
        padding: 7px 12px; font-size: 13px; font-weight: 700; cursor: pointer; color: var(--pt-text-2, #334); font-family: inherit;
    }
    .nav-editor-toolbar button:hover { background: var(--pt-hover, #eef4fb); }
    .nav-item-card { border: 1px solid var(--pt-border, #e5eaf1); border-radius: 0; padding: 12px; margin-bottom: 10px; background: var(--pt-panel-2, #fbfdff); }
    .nav-item-hd { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 10px; }
    .nav-item-hd .idx { font-size: 12px; font-weight: 700; color: var(--pt-accent, #0056b3); }
    .nav-item-actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .nav-item-actions button {
        border: 1px solid var(--pt-border-soft, #d5dde8); background: var(--pt-panel, #fff); border-radius: 0;
        padding: 5px 9px; font-size: 12px; cursor: pointer; color: var(--pt-text-2, #445); font-family: inherit;
    }
    .nav-item-actions button.danger { color: #b42318; border-color: #f0c2c0; }
    .nav-grid-fields { display: grid; grid-template-columns: 90px 1fr 1fr; gap: 10px; }
    .nav-grid-fields-2 { display: grid; grid-template-columns: 1fr 140px 140px; gap: 10px; margin-top: 10px; }
    .nav-checks { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 10px; font-size: 13px; color: var(--pt-text-2, #445); }
    .nav-checks label { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; }
    @media (max-width: 860px) {
        .settings-wrap { padding: 10px; }
        .settings-layout { grid-template-columns: 1fr; }
        .settings-tabs { position: static; display: flex; gap: 0; overflow-x: auto; }
        .settings-tab { white-space: nowrap; margin: 0; min-width: max-content; border-bottom: 0; border-right: 1px solid var(--pt-border, #d6dae0); }
        .settings-tab small { display: none; }
        .sla-row { grid-template-columns: 1fr; }
        .sla-row .prio-label { padding-bottom: 0; }
        .nav-grid-fields, .nav-grid-fields-2 { grid-template-columns: 1fr; }
    }
</style>
<main>
    <div class="settings-wrap">
        <div class="flex-header" style="display:flex;justify-content:space-between;align-items:center;margin:0 0 12px;gap:10px;flex-wrap:wrap;padding:8px 12px;background:var(--pt-panel-2,#e9ecf0);border:1px solid var(--pt-border-soft,#b9c1ca);">
            <h2 style="margin:0;color:var(--pt-text,#1f3a63);font-size:16px;">系统设置</h2>
            <a href="dashboard.php" class="btn" style="background:var(--pt-panel,#e9ecf0);color:var(--pt-text,#1a1a1a);border:1px solid var(--pt-border-soft,#8a8a8a);text-decoration:none;padding:6px 14px;font-size:13px;font-weight:700;">返回导航页</a>
        </div>

        <form id="system-settings-form" novalidate>
            <div class="settings-layout">
                <nav class="settings-tabs" id="settings-cat-tabs" aria-label="设置分类">
                    <% Object.keys(categories).forEach(function (catKey, idx) {
                        var cat = categories[catKey];
                    %>
                    <button type="button" class="settings-tab<%= idx === 0 ? ' active' : '' %>" data-cat-tab="<%= catKey %>">
                        <%= cat.label %>
                        <% if (cat.description) { %><small><%= cat.description %></small><% } %>
                    </button>
                    <% }) %>
                </nav>

                <div class="settings-panels">
                    <% Object.keys(categories).forEach(function (catKey, idx) {
                        var cat = categories[catKey];
                        var values = (settings && settings[catKey]) || {};
                    %>
                    <section class="settings-panel<%= idx === 0 ? ' active' : '' %>" data-category="<%= catKey %>">
                        <div class="settings-card">
                            <h3><%= cat.label %></h3>
                            <% if (cat.description) { %><p class="cat-desc"><%= cat.description %></p><% } %>

                            <% if (cat.fields) {
                                Object.keys(cat.fields).forEach(function (fieldKey) {
                                    var field = cat.fields[fieldKey];
                                    var val = values[fieldKey] != null ? values[fieldKey] : field.default;
                                    if (field.type === 'nav_items') {
                            %>
                            <div class="field">
                                <label>导航卡片</label>
                                <div class="nav-editor-toolbar">
                                    <button type="button" id="btn-nav-add">添加卡片</button>
                                    <button type="button" id="btn-nav-reset">恢复默认导航</button>
                                </div>
                                <div id="nav-items-editor"></div>
                                <textarea
                                    id="f-nav-nav_items"
                                    data-cat="nav"
                                    data-key="nav_items"
                                    hidden
                                ><%= val %></textarea>
                                <p style="margin:8px 0 0;font-size:12px;color:#888;line-height:1.5;">
                                    「仅管理员」卡片普通用户不可见；
                                </p>
                            </div>
                            <% } else if (field.type === 'toggle') {
                                var opts = field.options || [
                                    { value: '1', label: '打开' },
                                    { value: '0', label: '关闭' }
                                ];
                            %>
                            <div class="field">
                                <label for="f-<%= catKey %>-<%= fieldKey %>"><%= field.label %></label>
                                <select
                                    id="f-<%= catKey %>-<%= fieldKey %>"
                                    data-cat="<%= catKey %>"
                                    data-key="<%= fieldKey %>"
                                >
                                    <% opts.forEach(function (opt) { %>
                                    <option value="<%= opt.value %>"<%= String(val) === String(opt.value) ? ' selected' : '' %>><%= opt.label %></option>
                                    <% }) %>
                                </select>
                                <% if (fieldKey === 'id_card_found_enabled') { %>
                                <p style="margin:6px 0 0;font-size:12px;color:#888;">打开后，扫码结果页会显示该按钮，给捡到证件的人跳转登记。</p>
                                <% } %>
                            </div>
                            <% } else { %>
                            <div class="field">
                                <label for="f-<%= catKey %>-<%= fieldKey %>"><%= field.label %></label>
                                <input
                                    type="<%= field.type === 'url' ? 'url' : (field.type === 'number' ? 'number' : 'text') %>"
                                    id="f-<%= catKey %>-<%= fieldKey %>"
                                    name="<%= catKey %>.<%= fieldKey %>"
                                    data-cat="<%= catKey %>"
                                    data-key="<%= fieldKey %>"
                                    value="<%= val %>"
                                    placeholder="<%= field.placeholder || '' %>"
                                    <% if (field.type === 'number') { %>min="<%= field.min != null ? field.min : 1 %>" max="<%= field.max != null ? field.max : 1440 %>" step="1"<% } %>
                                    <% if (!field.optional) { %>required<% } %>
                                >
                                <% if (fieldKey === 'id_card_scan_base') { %>
                                <p style="margin:6px 0 0;font-size:12px;color:#666;">打印在证件上的扫码入口，所有证件共用。只含证件号，换绑队员二维码不变。不要填 127.0.0.1。须以 <code>http://</code> 或 <code>https://</code> 开头，例如 <code>http://服务器IP:12000</code>。</p>
                                <% } %>
                                <% if (fieldKey === 'id_card_found_label') { %>
                                <p style="margin:6px 0 0;font-size:12px;color:#888;">显示在扫码结果页按钮上，可改成任意名称。</p>
                                <% } %>
                                <% if (fieldKey === 'id_card_found_url') { %>
                                <p style="margin:6px 0 0;font-size:12px;color:#888;">按钮点击后打开的地址，须以 http:// 或 https:// 开头。链接里写 <code>{no}</code> 会替换成当前证件号。</p>
                                <% } %>
                            </div>
                            <% } %>
                            <% }); } %>

                            <% if (catKey === 'pwa') { %>
                            <div class="field">
                                <label>应用图标</label>
                                <div class="pwa-icon-row">
                                    <img id="pwa-icon-preview" src="/platform/pwa/icon-192.png" alt="当前图标">
                                    <div class="pwa-icon-side">
                                        <p class="pwa-icon-hint">
                                            上传一张 512×512 的 PNG 或 JPG，系统会自动生成 192 / 512 / 180 与 maskable 各尺寸，无需自己切图。<br>
                                            图标在手机端是静态资源：已装到桌面的手机重新打开 App 即可看到新图标；需 HTTPS 访问才生效。
                                        </p>
                                        <input type="file" id="pwa-icon-file" accept="image/png,image/jpeg">
                                        <div class="pwa-icon-actions">
                                            <button type="button" id="btn-pwa-icon-upload">上传并生成各尺寸</button>
                                            <span id="pwa-icon-msg" class="settings-msg"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <% } %>

                            <% if (cat.sections) {
                                var secKeys = Object.keys(cat.sections);
                            %>
                            <div class="subtabs" data-subtabs-for="<%= catKey %>">
                                <% secKeys.forEach(function (secKey, sidx) {
                                    var section = cat.sections[secKey];
                                %>
                                <button type="button" class="subtab<%= sidx === 0 ? ' active' : '' %>" data-section-tab="<%= secKey %>"><%= section.label %></button>
                                <% }) %>
                            </div>
                            <% secKeys.forEach(function (secKey, sidx) {
                                var section = cat.sections[secKey];
                            %>
                            <div class="settings-section<%= sidx === 0 ? ' active' : '' %>" data-section="<%= secKey %>">
                                <h4><%= section.label %></h4>
                                <% if (section.description) { %><p class="sec-desc"><%= section.description %></p><% } %>

                                <% if (section.groups) {
                                    Object.keys(section.groups).forEach(function (groupKey) {
                                        var group = section.groups[groupKey];
                                        var fieldKeys = Object.keys(group.fields || {});
                                        var levels = [
                                            { id: 'high', label: '高优先级' },
                                            { id: 'mid', label: '中优先级' },
                                            { id: 'low', label: '低优先级' }
                                        ];
                                %>
                                <div class="sla-group">
                                    <h5><%= group.label %></h5>
                                    <div class="sla-rows">
                                        <% levels.forEach(function (lv) {
                                            var warnKey = fieldKeys.find(function (k) { return k.indexOf('_' + lv.id + '_warn') !== -1; });
                                            var timeoutKey = fieldKeys.find(function (k) { return k.indexOf('_' + lv.id + '_timeout') !== -1; });
                                            var repeatKey = fieldKeys.find(function (k) { return k.indexOf('_' + lv.id + '_repeat') !== -1; });
                                            if (!warnKey || !timeoutKey) return;
                                            var warnField = group.fields[warnKey];
                                            var timeoutField = group.fields[timeoutKey];
                                            var repeatField = repeatKey ? group.fields[repeatKey] : null;
                                            var warnVal = values[warnKey] != null ? values[warnKey] : warnField.default;
                                            var timeoutVal = values[timeoutKey] != null ? values[timeoutKey] : timeoutField.default;
                                            var repeatVal = repeatField
                                                ? (values[repeatKey] != null ? values[repeatKey] : repeatField.default)
                                                : '0';
                                        %>
                                        <div class="sla-row">
                                            <div class="prio-label"><%= lv.label %></div>
                                            <div class="field compact">
                                                <label for="f-<%= catKey %>-<%= warnKey %>">预告</label>
                                                <div class="field-with-unit">
                                                    <input type="number" id="f-<%= catKey %>-<%= warnKey %>" data-cat="<%= catKey %>" data-key="<%= warnKey %>" value="<%= warnVal %>" min="<%= warnField.min != null ? warnField.min : 1 %>" max="<%= warnField.max != null ? warnField.max : 1440 %>" step="1" required>
                                                    <span class="unit">分钟</span>
                                                </div>
                                            </div>
                                            <div class="field compact">
                                                <label for="f-<%= catKey %>-<%= timeoutKey %>">超时</label>
                                                <div class="field-with-unit">
                                                    <input type="number" id="f-<%= catKey %>-<%= timeoutKey %>" data-cat="<%= catKey %>" data-key="<%= timeoutKey %>" value="<%= timeoutVal %>" min="<%= timeoutField.min != null ? timeoutField.min : 1 %>" max="<%= timeoutField.max != null ? timeoutField.max : 1440 %>" step="1" required>
                                                    <span class="unit">分钟</span>
                                                </div>
                                            </div>
                                            <% if (repeatKey && repeatField) { %>
                                            <div class="field compact">
                                                <label for="f-<%= catKey %>-<%= repeatKey %>">超时后重复</label>
                                                <div class="field-with-unit">
                                                    <input type="number" id="f-<%= catKey %>-<%= repeatKey %>" data-cat="<%= catKey %>" data-key="<%= repeatKey %>" value="<%= repeatVal %>" min="<%= repeatField.min != null ? repeatField.min : 0 %>" max="<%= repeatField.max != null ? repeatField.max : 1440 %>" step="1" required title="0 = 超时只提醒一次">
                                                    <span class="unit">分钟</span>
                                                </div>
                                            </div>
                                            <% } %>
                                        </div>
                                        <% }) %>
                                    </div>
                                </div>
                                <% }); } %>

                                <% if (section.fields) {
                                    Object.keys(section.fields).forEach(function (fieldKey) {
                                        var field = section.fields[fieldKey];
                                        var val = values[fieldKey] != null ? values[fieldKey] : field.default;
                                %>
                                <div class="field">
                                    <label for="f-<%= catKey %>-<%= fieldKey %>"><%= field.label %></label>
                                    <% if (field.type === 'toggle' || field.type === 'select') {
                                        var opts = field.options || [
                                            { value: '1', label: '打开' },
                                            { value: '0', label: '关闭' }
                                        ];
                                    %>
                                    <select id="f-<%= catKey %>-<%= fieldKey %>" data-cat="<%= catKey %>" data-key="<%= fieldKey %>">
                                        <% opts.forEach(function (opt) { %>
                                        <option value="<%= opt.value %>"<%= String(val) === String(opt.value) ? ' selected' : '' %>><%= opt.label %></option>
                                        <% }) %>
                                    </select>
                                    <% if (fieldKey === 'rms_display_chart_scope_default') { %>
                                    <p style="margin:6px 0 0;font-size:12px;color:#888;">展示页统计图默认显示事件</p>
                                    <% } %>
                                    <% if (fieldKey === 'rms_display_chart_rotate') { %>
                                    <p style="margin:6px 0 0;font-size:12px;color:#888;">打开后按间隔在「进行中 / 已完成 / 全部」之间轮换</p>
                                    <% } %>
                                    <% if (fieldKey === 'rms_display_chart_skip_empty') { %>
                                    <p style="margin:6px 0 0;font-size:12px;color:#888;">开启后，自动轮换会跳过当前没有事件的统计表</p>
                                    <% } %>
                                    <% } else if (field.type === 'textarea') { %>
                                    <textarea id="f-<%= catKey %>-<%= fieldKey %>" data-cat="<%= catKey %>" data-key="<%= fieldKey %>" rows="<%= field.rows || 5 %>" placeholder="<%= field.placeholder || '' %>" style="width:100%;box-sizing:border-box;padding:11px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px;line-height:1.5;resize:vertical;"><%= val %></textarea>
                                    <% if (fieldKey === 'agency_list') { %>
                                    <p style="margin:6px 0 0;font-size:12px;color:#888;">每行一个分区名称；保存后可在队员档案中选择。</p>
                                    <% } %>
                                    <% } else if (field.type === 'number') { %>
                                    <div class="field-with-unit">
                                        <input
                                            type="number"
                                            id="f-<%= catKey %>-<%= fieldKey %>"
                                            data-cat="<%= catKey %>"
                                            data-key="<%= fieldKey %>"
                                            value="<%= val %>"
                                            min="<%= field.min != null ? field.min : 1 %>"
                                            max="<%= field.max != null ? field.max : 1440 %>"
                                            step="1"
                                            required
                                        >
                                        <% if (field.unit) { %><span class="unit"><%= field.unit %></span><% } %>
                                    </div>
                                    <% if (fieldKey === 'rms_display_chart_rotate_sec') { %>
                                    <p style="margin:6px 0 0;font-size:12px;color:#888;">仅在开启自动轮换时生效，建议 15～60 秒。</p>
                                    <% } %>
                                    <% } else { %>
                                    <input
                                        type="<%= field.type === 'url' ? 'url' : 'text' %>"
                                        id="f-<%= catKey %>-<%= fieldKey %>"
                                        data-cat="<%= catKey %>"
                                        data-key="<%= fieldKey %>"
                                        value="<%= val %>"
                                        placeholder="<%= field.placeholder || '' %>"
                                        <% if (fieldKey === 'wecom_webhook_url' || fieldKey === 'rms_firstaid_form_url') { %>inputmode="url" autocomplete="off"<% } %>
                                        <% if (fieldKey === 'wecom_app_corp_id' || fieldKey === 'wecom_app_agent_id' || fieldKey === 'wecom_app_secret') { %>autocomplete="off" spellcheck="false"<% } %>
                                        <% if (fieldKey === 'commander_user_ids') { %>readonly data-skip-submit="1"<% } %>
                                    >
                                    <% if (fieldKey === 'wecom_app_corp_id') { %>
                                    <p style="margin:6px 0 0;font-size:12px;color:#888;">企业微信后台 → 我的企业 → 企业信息 → 企业ID（CorpID）</p>
                                    <% } %>
                                    <% if (fieldKey === 'wecom_app_agent_id') { %>
                                    <p style="margin:6px 0 0;font-size:12px;color:#888;">企业微信后台 → 应用管理 → 自建 → 应用 → AgentId（数字）</p>
                                    <% } %>
                                    <% if (fieldKey === 'wecom_app_secret') { %>
                                    <p style="margin:6px 0 0;font-size:12px;color:#888;">企业微信后台 → 应用管理 → 自建 → 应用 → Secret（保存后仅管理员可见）</p>
                                    <% } %>
                                    <% if (fieldKey === 'wecom_webhook_url') { %>
                                    <p style="margin:6px 0 0;font-size:12px;color:#888;">已停用：系统不再向群机器人发消息，此值仅作留档</p>
                                    <% } %>
                                    <% if (fieldKey === 'wecom_api_base') { %>
                                    <p style="margin:6px 0 0;font-size:12px;color:#888;">留空＝直连 qyapi.weixin.qq.com；填云服务器反代地址后，企业微信看到的出口 IP 是云服务器固定 IP（需把该 IP 加入「企业可信IP」）</p>
                                    <% } %>
                                    <% if (fieldKey === 'wecom_api_key') { %>
                                    <p style="margin:6px 0 0;font-size:12px;color:#888;">可选：填写后请求带 X-Proxy-Key 头，供反代校验来源（仅管理员可见）</p>
                                    <% } %>
                                    <% if (fieldKey === 'commander_user_ids') { %>
                                    <p style="margin:6px 0 0;font-size:12px;color:#888;">一般不用手改：请在调度台「指挥官」中勾选人员（JSON 用户ID数组，如 [2,5]）</p>
                                    <% } %>
                                    <% if (fieldKey === 'rms_firstaid_form_url') { %>
                                    <p style="margin:6px 0 0;font-size:12px;color:#888;">成员终端「急救表单」按钮跳转地址</p>
                                    <% } %>
                                    <% } %>
                                </div>
                                <% }); } %>
                            </div>
                            <% }) %>
                            <% } %>
                        </div>
                    </section>
                    <% }) %>
                </div>
            </div>

            <div class="settings-actions">
                <button type="submit" class="btn-save">保存设置</button>
                <span id="settings-msg" class="settings-msg" role="status"></span>
            </div>
            <p class="settings-hint"></p>
        </form>
    </div>
    <div id="reauthModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:9999; align-items:center; justify-content:center; padding:16px;">
        <div style="background:#fff; border-radius:12px; padding:22px; max-width:400px; width:100%;">
            <h3 style="margin:0 0 8px;">二次授权</h3>
            <p id="reauthHint" style="font-size:13px; color:#64748b; margin:0 0 12px;"></p>
            <label style="font-size:13px;">当前账号密码</label>
            <input type="password" id="reauthPass" style="width:100%; box-sizing:border-box; padding:10px; margin:6px 0 10px; border:1px solid #ddd; border-radius:8px;">
            <div id="reauthTotpWrap" style="display:none;">
                <label style="font-size:13px;">动态验证码</label>
                <input type="text" id="reauthTotp" inputmode="numeric" maxlength="8" autocomplete="one-time-code" style="width:100%; box-sizing:border-box; padding:10px; margin:6px 0 10px; border:1px solid #ddd; border-radius:8px;">
            </div>
            <p id="reauthErr" style="display:none; color:#dc3545; font-size:13px;"></p>
            <div style="display:flex; gap:8px; margin-top:12px;">
                <button type="button" id="reauthCancel" style="flex:1; padding:10px; border:none; border-radius:8px; background:#e2e8f0;">取消</button>
                <button type="button" id="reauthOk" style="flex:1; padding:10px; border:none; border-radius:8px; background:#0056b3; color:#fff;">确认</button>
            </div>
        </div>
    </div>
</main>
<script>
(function () {
    var form = document.getElementById('system-settings-form');
    var msg = document.getElementById('settings-msg');
    var DEFAULT_NAV = <%- JSON.stringify(navItems || []) %>;
    var FACTORY_DEFAULT_NAV = <%- JSON.stringify(defaultNavItems || []) %>;

    function esc(s) {
        return String(s == null ? '' : s)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function readNavFromEditor() {
        var cards = document.querySelectorAll('#nav-items-editor .nav-item-card');
        var list = [];
        cards.forEach(function (card, idx) {
            var id = (card.querySelector('[data-f="id"]') || {}).value || ('item_' + (idx + 1));
            var locked = id === 'system_settings' || card.getAttribute('data-locked') === '1';
            list.push({
                id: id,
                icon: (card.querySelector('[data-f="icon"]') || {}).value || '',
                title: (card.querySelector('[data-f="title"]') || {}).value || '',
                desc: (card.querySelector('[data-f="desc"]') || {}).value || '',
                href: (card.querySelector('[data-f="href"]') || {}).value || '',
                target: (card.querySelector('[data-f="target"]') || {}).value || '_self',
                accent: (card.querySelector('[data-f="accent"]') || {}).value || '',
                admin_only: locked ? true : !!(card.querySelector('[data-f="admin_only"]') || {}).checked,
                enabled: locked ? true : !!(card.querySelector('[data-f="enabled"]') || {}).checked
            });
        });
        return list;
    }

    function syncNavHidden() {
        var el = document.getElementById('f-nav-nav_items');
        if (!el) return;
        el.value = JSON.stringify(readNavFromEditor());
    }

    function renderNavEditor(items) {
        var box = document.getElementById('nav-items-editor');
        if (!box) return;
        if (!items || !items.length) items = FACTORY_DEFAULT_NAV.slice();
        box.innerHTML = items.map(function (item, idx) {
            var locked = item.id === 'system_settings';
            return (
                '<div class="nav-item-card" data-idx="' + idx + '"' + (locked ? ' data-locked="1"' : '') + '>' +
                    '<div class="nav-item-hd">' +
                        '<span class="idx">卡片 #' + (idx + 1) + (locked ? ' · 系统' : '') + '</span>' +
                        '<div class="nav-item-actions">' +
                            '<button type="button" data-act="up">上移</button>' +
                            '<button type="button" data-act="down">下移</button>' +
                            '<button type="button" data-act="dup">复制</button>' +
                            (locked ? '' : '<button type="button" class="danger" data-act="del">删除</button>') +
                        '</div>' +
                    '</div>' +
                    '<div class="nav-grid-fields">' +
                        '<div class="field compact"><label>图标</label><input data-f="icon" value="' + esc(item.icon) + '" maxlength="16" placeholder="可留空"></div>' +
                        '<div class="field compact"><label>名称</label><input data-f="title" value="' + esc(item.title) + '" maxlength="80" required></div>' +
                        '<div class="field compact"><label>简介</label><input data-f="desc" value="' + esc(item.desc) + '" maxlength="200"></div>' +
                    '</div>' +
                    '<div class="nav-grid-fields-2">' +
                        '<div class="field compact"><label>跳转地址</label><input data-f="href" value="' + esc(item.href) + '" maxlength="500" required></div>' +
                        '<div class="field compact"><label>打开方式</label><select data-f="target"><option value="_self"' + (item.target === '_blank' ? '' : ' selected') + '>当前窗口</option><option value="_blank"' + (item.target === '_blank' ? ' selected' : '') + '>新窗口</option></select></div>' +
                        '<div class="field compact"><label>强调色（可选）</label><input data-f="accent" value="' + esc(item.accent || '') + '" placeholder="#28a745"></div>' +
                    '</div>' +
                    '<input type="hidden" data-f="id" value="' + esc(item.id || ('item_' + (idx + 1))) + '">' +
                    '<div class="nav-checks">' +
                        '<label><input type="checkbox" data-f="enabled"' + (item.enabled === false && !locked ? '' : ' checked') + (locked ? ' disabled' : '') + '> 启用</label>' +
                        '<label><input type="checkbox" data-f="admin_only"' + (item.admin_only || locked ? ' checked' : '') + (locked ? ' disabled' : '') + '> 仅管理员可见</label>' +
                    '</div>' +
                '</div>'
            );
        }).join('');
        syncNavHidden();
    }

    function bindNavEditor() {
        var box = document.getElementById('nav-items-editor');
        if (!box || box._bound) return;
        box._bound = true;
        box.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-act]');
            if (!btn) return;
            var card = btn.closest('.nav-item-card');
            if (!card) return;
            var list = readNavFromEditor();
            var idx = Array.prototype.indexOf.call(box.querySelectorAll('.nav-item-card'), card);
            var act = btn.getAttribute('data-act');
            if (act === 'up' && idx > 0) {
                var t = list[idx - 1]; list[idx - 1] = list[idx]; list[idx] = t;
            } else if (act === 'down' && idx < list.length - 1) {
                var t2 = list[idx + 1]; list[idx + 1] = list[idx]; list[idx] = t2;
            } else if (act === 'dup') {
                var copy = Object.assign({}, list[idx], { id: (list[idx].id || 'item') + '_copy_' + Date.now() });
                list.splice(idx + 1, 0, copy);
            } else if (act === 'del') {
                if (list[idx] && list[idx].id === 'system_settings') return;
                if (list.length <= 1) { alert('至少保留一张导航卡片'); return; }
                if (!confirm('删除该导航卡片？')) return;
                list.splice(idx, 1);
            } else {
                return;
            }
            renderNavEditor(list);
        });
        box.addEventListener('input', syncNavHidden);
        box.addEventListener('change', syncNavHidden);
    }

    var addBtn = document.getElementById('btn-nav-add');
    if (addBtn) {
        addBtn.addEventListener('click', function () {
            var list = readNavFromEditor();
            list.push({
                id: 'item_' + Date.now(),
                icon: '',
                title: '新模块',
                desc: '',
                href: '/',
                target: '_self',
                admin_only: false,
                enabled: true,
                accent: ''
            });
            renderNavEditor(list);
        });
    }
    var resetBtn = document.getElementById('btn-nav-reset');
    if (resetBtn) {
        resetBtn.addEventListener('click', function () {
            if (!confirm('恢复为默认导航卡片列表？未保存的修改会丢失。')) return;
            renderNavEditor(FACTORY_DEFAULT_NAV.slice());
        });
    }

    // 分类切换
    document.getElementById('settings-cat-tabs').addEventListener('click', function (e) {
        var btn = e.target.closest('[data-cat-tab]');
        if (!btn) return;
        var key = btn.getAttribute('data-cat-tab');
        document.querySelectorAll('[data-cat-tab]').forEach(function (el) {
            el.classList.toggle('active', el === btn);
        });
        document.querySelectorAll('.settings-panel').forEach(function (panel) {
            panel.classList.toggle('active', panel.getAttribute('data-category') === key);
        });
    });

    // RMS 子分类切换
    document.querySelectorAll('[data-subtabs-for]').forEach(function (bar) {
        bar.addEventListener('click', function (e) {
            var btn = e.target.closest('[data-section-tab]');
            if (!btn) return;
            var panel = bar.closest('.settings-panel');
            if (!panel) return;
            var key = btn.getAttribute('data-section-tab');
            bar.querySelectorAll('[data-section-tab]').forEach(function (el) {
                el.classList.toggle('active', el === btn);
            });
            panel.querySelectorAll('.settings-section').forEach(function (sec) {
                sec.classList.toggle('active', sec.getAttribute('data-section') === key);
            });
        });
    });

    bindNavEditor();
    renderNavEditor(DEFAULT_NAV && DEFAULT_NAV.length ? DEFAULT_NAV : FACTORY_DEFAULT_NAV);

    var PAGE_CSRF = <%- JSON.stringify(typeof csrf !== 'undefined' ? csrf : '') %>;
    var LOGS_CURRENT = <%- JSON.stringify((settings && settings.logs) || {}) %>;
    var ACTOR_HAS_2FA = <%= (typeof actorHas2fa !== 'undefined' && actorHas2fa) ? 'true' : 'false' %>;

    function logsChanged(settings) {
        var bag = settings.logs || {};
        var keys = Object.keys(LOGS_CURRENT);
        if (!keys.length) keys = Object.keys(bag);
        return keys.some(function (k) {
            return String(LOGS_CURRENT[k] || '') !== String(bag[k] || '');
        });
    }

    function askReauth() {
        return new Promise(function (resolve, reject) {
            var modal = document.getElementById('reauthModal');
            var passEl = document.getElementById('reauthPass');
            var totpEl = document.getElementById('reauthTotp');
            var totpWrap = document.getElementById('reauthTotpWrap');
            var hint = document.getElementById('reauthHint');
            var errEl = document.getElementById('reauthErr');
            passEl.value = '';
            totpEl.value = '';
            errEl.style.display = 'none';
            totpWrap.style.display = ACTOR_HAS_2FA ? 'block' : 'none';
            hint.textContent = ACTOR_HAS_2FA
                ? '修改日志保留需密码和动态验证码，随后请到服务器终端确认。'
                : '修改日志保留需输入当前账号密码，随后请到服务器终端确认。';
            modal.style.display = 'flex';
            passEl.focus();
            function close(ok) {
                modal.style.display = 'none';
                document.getElementById('reauthOk').removeEventListener('click', onOk);
                document.getElementById('reauthCancel').removeEventListener('click', onCancel);
                if (ok) resolve({ password: passEl.value, totp: totpEl.value });
                else reject(new Error('cancelled'));
            }
            function onCancel() { close(false); }
            function onOk() {
                if (!passEl.value) {
                    errEl.textContent = '请输入密码';
                    errEl.style.display = 'block';
                    return;
                }
                if (ACTOR_HAS_2FA && !totpEl.value) {
                    errEl.textContent = '请输入动态验证码';
                    errEl.style.display = 'block';
                    return;
                }
                close(true);
            }
            document.getElementById('reauthCancel').addEventListener('click', onCancel);
            document.getElementById('reauthOk').addEventListener('click', onOk);
        });
    }

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        syncNavHidden();
        var settings = {};
        form.querySelectorAll('input[data-cat][data-key], textarea[data-cat][data-key], select[data-cat][data-key]').forEach(function (input) {
            if (input.getAttribute('data-skip-submit') === '1') return;
            var cat = input.getAttribute('data-cat');
            var key = input.getAttribute('data-key');
            if (!settings[cat]) settings[cat] = {};
            settings[cat][key] = input.value.trim();
        });
        var needLogsConfirm = logsChanged(settings);
        var run = Promise.resolve(null);
        if (needLogsConfirm) run = askReauth();
        run.then(function (reauth) {
            msg.textContent = needLogsConfirm ? '等待服务器终端确认（y/n 与确认码）…' : '保存中…';
            msg.className = 'settings-msg';
            var body = { settings: settings };
            body.csrf_token = PAGE_CSRF;
            if (reauth) {
                body.confirm_password = reauth.password;
                body.confirm_totp = reauth.totp;
            }
            return fetch('/api/system-settings', {
                method: 'PUT',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body),
                signal: AbortSignal.timeout ? AbortSignal.timeout(360000) : undefined
            }).then(function (r) { return r.json().then(function (data) { return { ok: r.ok, data: data }; }); });
        }).then(function (res) {
            if (!res) return;
            if (!res.ok || !res.data.success) {
                msg.textContent = (res.data && res.data.message) || '保存失败';
                msg.className = 'settings-msg err';
                return;
            }
            msg.textContent = res.data.message || '已保存';
            msg.className = 'settings-msg ok';
            if (res.data.settings && res.data.settings.logs) LOGS_CURRENT = res.data.settings.logs;
            try {
                if (res.data.settings && res.data.settings.nav && res.data.settings.nav.nav_items) {
                    renderNavEditor(JSON.parse(res.data.settings.nav.nav_items));
                }
            } catch (err) { /* ignore */ }
        }).catch(function (err) {
            if (err && err.message === 'cancelled') {
                msg.textContent = '已取消';
                msg.className = 'settings-msg';
                return;
            }
            msg.textContent = '网络错误或等待超时';
            msg.className = 'settings-msg err';
        });
    });

    // PWA 图标：不是系统设置字段，单独走上传接口（服务端重新编码后派生各尺寸）
    (function () {
        var btn = document.getElementById('btn-pwa-icon-upload');
        var fileEl = document.getElementById('pwa-icon-file');
        var msgEl = document.getElementById('pwa-icon-msg');
        var preview = document.getElementById('pwa-icon-preview');
        if (!btn || !fileEl || !msgEl) return;

        btn.addEventListener('click', function () {
            var file = fileEl.files && fileEl.files[0];
            if (!file) {
                msgEl.textContent = '请先选择图片';
                msgEl.className = 'settings-msg err';
                return;
            }
            var body = new FormData();
            body.append('icon', file);
            body.append('csrf_token', PAGE_CSRF);

            btn.disabled = true;
            msgEl.textContent = '上传中…';
            msgEl.className = 'settings-msg';

            fetch('/api/pwa-icon', {
                method: 'POST',
                credentials: 'same-origin',
                body: body
            }).then(function (r) {
                return r.json().then(function (data) { return { ok: r.ok, data: data }; });
            }).then(function (res) {
                if (!res.ok || !res.data.success) {
                    msgEl.textContent = (res.data && res.data.message) || '上传失败';
                    msgEl.className = 'settings-msg err';
                    return;
                }
                msgEl.textContent = res.data.message || '图标已更新';
                msgEl.className = 'settings-msg ok';
                if (preview) preview.src = '/platform/pwa/icon-192.png?t=' + Date.now();
                fileEl.value = '';
            }).catch(function () {
                msgEl.textContent = '网络错误，上传失败';
                msgEl.className = 'settings-msg err';
            }).then(function () {
                btn.disabled = false;
            });
        });
    })();
})();
</script>
<%- include('partials/footer') %>
