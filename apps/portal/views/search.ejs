<%- include('partials/header') %>
<style>
    body { background-color: #d9e4f4; }
    .search-bar { max-width: 820px; margin: 24px auto 18px; padding: 0 12px; }
    .search-form {
        display: flex;
        width: 100%;
        padding: 0;
        margin: 0;
        background: #fff;
        border: 2px solid #0b2d6b;
        border-radius: 0;
        box-shadow: none;
        overflow: hidden;
    }
    .search-box, .search-box:focus {
        flex: 1;
        min-width: 0;
        padding: 12px 14px;
        border: 0;
        border-radius: 0;
        outline: none;
        font-size: 16px;
        background: #fff;
        box-shadow: none;
        -webkit-appearance: none;
        appearance: none;
    }
    .search-btn, .search-btn:hover {
        flex: 0 0 112px;
        padding: 12px 10px;
        background: #0b2d6b;
        color: #fff;
        border: 0;
        border-left: 2px solid #0b2d6b;
        border-radius: 0;
        cursor: pointer;
        font-size: 15px;
        font-weight: 700;
        -webkit-appearance: none;
        appearance: none;
    }
    .search-btn:hover { background: #082253; }
    .search-err { text-align: center; color: #b45309; font-weight: 700; margin: 12px 0 0; }
    .search-miss { text-align: center; color: #b42318; font-weight: 700; margin: 28px 12px; }
    @media (max-width: 640px) {
        .search-bar { margin: 16px 0 12px; padding: 0 12px; }
        .search-form { flex-direction: column; }
        .search-box { border-bottom: 2px solid #0b2d6b; }
        .search-btn, .search-btn:hover { flex: none; width: 100%; border-left: 0; }
    }
</style>
<main style="flex: 1;" class="vp-page">
    <div class="search-bar">
        <form method="GET" class="search-form">
            <input type="text" name="query" class="search-box" placeholder="请输入人员姓名或内部编号..." value="<%= q %>" required>
            <button type="submit" class="search-btn">档案检索</button>
        </form>
        <% if (typeof error !== 'undefined' && error) { %>
        <p class="search-err"><%= error %></p>
        <% } %>
    </div>

    <% if (q) { %>
        <% if (volunteer) { %>
            <%- include('partials/volunteer_profile') %>
        <% } else { %>
            <div class="search-miss">未检索到符合条件的队员，请核对姓名或编号。</div>
        <% } %>
    <% } %>
</main>
<%- include('partials/footer') %>
