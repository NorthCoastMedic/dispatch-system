<%- include('partials/header') %>
<style>
    body { background-color: #d9e4f4; }
    .found-wrap { max-width: 820px; margin: -12px auto 40px; padding: 0 12px; text-align: center; }
    .found-btn {
        display: inline-block; background: #fff; color: #0b2d6b; border: 2px solid #0b2d6b;
        padding: 12px 22px; text-decoration: none; font-weight: 700;
    }
    .found-btn:hover { background: #0b2d6b; color: #fff; }
    .found-hint { margin: 10px 0 0; font-size: 13px; color: #556; line-height: 1.5; }
    .empty-msg { text-align: center; color: #b42318; font-weight: 700; margin: 48px 16px; }
    @media (max-width: 640px) {
        .found-wrap { margin-top: 0; }
        .found-btn { display: block; }
    }
</style>
<main style="flex: 1;" class="vp-page">
    <% if (typeof error !== 'undefined' && error) { %>
        <p class="empty-msg"><%= error %></p>
    <% } else if (volunteer) { %>
        <div style="height: 20px;"></div>
        <%- include('partials/volunteer_profile') %>
    <% } else { %>
        <p class="empty-msg" style="color:#445;">请扫描证件上的二维码。</p>
    <% } %>
    <% if (typeof foundLink !== 'undefined' && foundLink) { %>
        <div class="found-wrap">
            <a class="found-btn" href="<%= foundLink.url %>" target="_blank" rel="noopener noreferrer"><%= foundLink.label %></a>
            <p class="found-hint">若您捡到此证，请点此登记，便于归还。</p>
        </div>
    <% } %>
</main>
<%- include('partials/footer') %>
