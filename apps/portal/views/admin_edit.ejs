<%- include('partials/header') %>
<style>
    :root { --primary-color: #0056b3; --border-color: #eee; }
    .admin-main { max-width: 1000px; margin: 30px auto; padding: 0 15px; box-sizing: border-box; }
    .flex-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 10px; }
    .card { background: #fff; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); margin-bottom: 25px; }
    .card-header { margin-top: 0; border-bottom: 2px solid var(--border-color); padding-bottom: 10px; }
    .grid-form { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
    .grid-full { grid-column: span 2; }
    .input-field { width: 100%; padding: 10px; margin-top: 5px; box-sizing: border-box; border: 1px solid #ccc; border-radius: 4px; }
    .split-layout { display: flex; gap: 25px; flex-wrap: wrap; }
    .split-panel { flex: 1; min-width: 300px; box-sizing: border-box; }
    .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
    .admin-table { width: 100%; text-align: left; border-collapse: collapse; min-width: 600px; }
    .admin-table th, .admin-table td { padding: 15px; border-bottom: 1px solid #eee; }
    .btn-group { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
    .btn { padding: 8px 15px; border-radius: 5px; text-decoration: none; font-weight: bold; cursor: pointer; border: none; display: inline-block; text-align: center; }
    .quick-add-form { display: flex; gap: 15px; align-items: center; flex-wrap: wrap; }
    .quick-add-form input, .quick-add-form select, .quick-add-form button { flex: 1; min-width: 120px; }
    .upload-box {
        border: 1px dashed var(--pt-border-soft, #ccc);
        border-radius: 6px;
        padding: 12px;
        background: var(--pt-panel-2, #fafafa);
    }
    .upload-box small, .upload-box p { color: var(--pt-muted, #666); }
    .delete-vol-bar { margin-top: 28px; padding-top: 16px; border-top: 1px solid var(--pt-border, #eee); }
    .id-badge { display:inline-block; padding:2px 8px; border-radius:10px; font-size:12px; font-weight:bold; }
    .id-badge-bound { background:#d4edda; color:#155724; }
    .id-badge-unbound { background:#e9ecef; color:#495057; }
    .id-badge-lost { background:#f8d7da; color:#721c24; }
    .id-card-row-form { display:flex; flex-wrap:wrap; gap:8px; align-items:center; }
    .id-card-row-form .input-field { margin-top:0; min-width:120px; flex:1; }
    .qr-modal { display:none; position:fixed; z-index:9999; inset:0; background:rgba(0,0,0,0.55); align-items:center; justify-content:center; padding:16px; }
    .qr-modal.show { display:flex; }
    .qr-box { background:#fff; border-radius:10px; padding:24px; max-width:360px; width:100%; text-align:center; }
    .admin-tabs { display:flex; flex-wrap:wrap; gap:6px; margin:0 0 20px; padding:4px; background:var(--pt-panel-2, #f1f5f9); border-radius:10px; }
    .admin-tab {
        flex:1; min-width:140px; text-align:center; padding:12px 16px; border:none; border-radius:8px;
        background:transparent; color:#475569; font-weight:bold; font-size:15px; cursor:pointer;
        text-decoration:none; font-family:inherit;
    }
    .admin-tab:hover { background:rgba(255,255,255,0.7); color:#0056b3; }
    .admin-tab.active { background:#fff; color:#0056b3; box-shadow:0 1px 4px rgba(0,0,0,0.08); }
    .admin-tab small { display:block; font-weight:normal; font-size:12px; color:#94a3b8; margin-top:2px; }
    .admin-tab.active small { color:#64748b; }
    .admin-pane { display:none; }
    .admin-pane.active { display:block; }
    @media print {
        body * { visibility: hidden; }
        .qr-box, .qr-box * { visibility: visible; }
        .qr-box { position: absolute; left: 0; top: 0; box-shadow: none; }
        .qr-actions { display: none !important; }
    }
    @media (max-width: 768px) {
        .admin-main { margin: 15px auto; }
        .grid-form { grid-template-columns: 1fr; }
        .grid-full { grid-column: span 1; }
        .split-layout { flex-direction: column; }
        .card { padding: 15px; }
        .btn-group { justify-content: flex-start; margin-top: 10px; }
        .quick-add-form { flex-direction: column; align-items: stretch; }
    }
</style>
<main class="admin-main">
    <% if (msg) { %><div style="background:#d4edda; color:#155724; padding:12px; border-radius:5px; margin-bottom:20px; border:1px solid #c3e6cb; font-weight:bold;"><%= msg %></div><% } %>

    <% if (mode === 'edit_vol' && vol) { %>
        <div class="flex-header">
            <h2>📝 编辑档案：<%= vol.name %> (<%= vol.badge_number %>)</h2>
            <div class="btn-group">
                <a href="admin_edit.php?tab=people" class="btn" style="background:#6c757d; color:white;">返回列表</a>
            </div>
        </div>
        <nav class="admin-tabs" role="tablist">
            <button type="button" class="admin-tab active" data-pane="vol-base">基础信息<small>档案 / 头像 / 分区</small></button>
            <button type="button" class="admin-tab" data-pane="vol-certs">资质证书<small><%= certs.length %> 项</small></button>
        </nav>
        <div id="vol-base" class="admin-pane active">
        <div class="card">
            <h3 class="card-header">👤 基础信息</h3>
            <form method="POST" action="/admin_edit.php" class="grid-form" enctype="multipart/form-data">
                <input type="hidden" name="csrf_token" value="<%= csrf %>">
                <input type="hidden" name="vid" value="<%= vol.id %>">
                <input type="hidden" name="update_base" value="1">
                <label>入队时间: <input type="date" name="join_date" value="<%= vol.join_date || '' %>" class="input-field"></label>
                <label>血型: <input type="text" name="blood_type" value="<%= vol.blood_type || '' %>" placeholder="如: O型" class="input-field"></label>
                <label>手机号: <input type="text" name="phone" value="<%= vol.phone || '' %>" placeholder="如 13800138000" class="input-field" maxlength="20" inputmode="numeric" autocomplete="tel"></label>
                <label>Agency / 分区:
                    <select name="agency" class="input-field">
                        <option value="">未分区</option>
                        <%
                            var agencyOptions = Array.isArray(agencies) ? agencies.slice() : [];
                            var currentAgency = vol.agency || '';
                            if (currentAgency && agencyOptions.indexOf(currentAgency) === -1) {
                                agencyOptions.unshift(currentAgency);
                            }
                            agencyOptions.forEach(function (ag) {
                        %>
                        <option value="<%= ag %>" <%= currentAgency === ag ? 'selected' : '' %>><%= ag %></option>
                        <% }) %>
                    </select>
                </label>
                <% if (!agencies || !agencies.length) { %>
                <p class="grid-full" style="margin:0; font-size:12px; color:#b45309;">尚未配置分区列表，请先到「系统设置 → RMS → Agency / 分区」添加。</p>
                <% } %>
                <label>在职状态:
                    <select name="status" class="input-field">
                        <option value="active" <%= vol.status === 'active' ? 'selected' : '' %>>有效</option>
                        <option value="inactive" <%= vol.status === 'inactive' ? 'selected' : '' %>>失效</option>
                    </select>
                </label>
                <p class="grid-full" style="margin:0; font-size:14px; color:#555;">
                    实体证件：
                    <% if (vol.id_card_no) { %>
                    <strong><%= vol.id_card_no %></strong>
                    <a href="admin_edit.php?tab=cards" style="margin-left:8px;">去证件管理</a>
                    <% } else { %>
                    未绑定（可在列表页「实体证件」中绑定或改回未绑定）
                    <% } %>
                </p>
                <div class="grid-full upload-box">
                    <div style="font-weight:bold; margin-bottom:8px;">队员头像</div>
                    <% if (vol.avatar_url) { %>
                    <div style="margin-bottom:10px;">
                        <small style="display:block; margin-bottom:6px;">当前头像：</small>
                        <% if (/^https?:\/\//i.test(String(vol.avatar_url))) { %>
                        <img src="<%= vol.avatar_url %>" alt="当前头像" style="width:96px; height:96px; object-fit:cover; border-radius:50%; border:1px solid var(--pt-border, #e2e8f0); background: var(--pt-input-bg, #fff);">
                        <small style="display:block; color:#b45309; margin-top:6px;">请重新上传本地文件以替换。</small>
                        <% } else { %>
                        <img src="<%= vol.avatar_src %>" alt="当前头像" style="width:96px; height:96px; object-fit:cover; border-radius:50%; border:1px solid var(--pt-border, #e2e8f0); background: var(--pt-input-bg, #fff);">
                        <% } %>
                    </div>
                    <% } else { %>
                    <p style="font-size:13px; margin:0 0 10px;">尚未上传头像</p>
                    <% } %>
                    <small style="display:block; margin-bottom:5px;">上传/更换头像：</small>
                    <input type="file" name="avatar_image" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="input-field">
                    <small style="display:block; margin-top:6px;">不上传文件则保留原头像。</small>
                </div>
                <div class="grid-full">
                    <button type="submit" class="btn" style="background:#28a745; color:white; width:100%; padding:12px; font-size:16px;">保存基础信息</button>
                </div>
            </form>
        </div>
        <form method="POST" action="/admin_edit.php" class="delete-vol-bar js-reauth-form">
            <input type="hidden" name="csrf_token" value="<%= csrf %>">
            <input type="hidden" name="delete_volunteer" value="1">
            <input type="hidden" name="vid" value="<%= vol.id %>">
            <button type="submit" class="btn" style="background:#dc3545; color:white;">删除队员</button>
        </form>
        </div>
        <div id="vol-certs" class="admin-pane">
        <div class="split-layout">
            <div class="card split-panel">
                <h3 class="card-header">📋 已录入资质</h3>
                <ul style="list-style:none; padding:0; margin:0;">
                    <% certs.forEach(function(c) { %>
                    <li style="padding:12px 0; border-bottom:1px solid #f0f0f0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
                        <span>
                            <strong style="color:<%= c.color %>;"><%= c.label %></strong>
                            <%= c.cert_name %>
                            <small><%= c.dateInfo %></small>
                            <% if (c.show_on_dispatch) { %>
                            <span style="display:inline-block; margin-left:6px; padding:1px 6px; font-size:11px; border-radius:10px; background:#e7f1ff; color:#0056b3; font-weight:bold;">调度可见</span>
                            <% } %>
                        </span>
                        <div class="btn-group">
                            <a href="?edit_cert_id=<%= c.id %>&type=<%= c.type %>&vid=<%= vol.id %>" class="btn" style="background:#ffc107; color:#333; padding:5px 10px; font-size:13px;">编辑</a>
                            <form method="POST" action="/admin_edit.php" style="display:inline;" class="js-reauth-form">
                                <input type="hidden" name="csrf_token" value="<%= csrf %>">
                                <input type="hidden" name="del_cert" value="<%= c.id %>">
                                <input type="hidden" name="type" value="<%= c.type %>">
                                <input type="hidden" name="vid" value="<%= vol.id %>">
                                <button type="submit" class="btn" style="background:#dc3545; color:white; padding:5px 10px; font-size:13px;">删除</button>
                            </form>
                        </div>
                    </li>
                    <% }) %>
                </ul>
            </div>
            <div class="card split-panel" style="background:#f8f9fa; border:1px solid #ddd;">
                <h3 class="card-header">➕ 颁发/录入新资质</h3>
                <form method="POST" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:15px;">
                    <input type="hidden" name="csrf_token" value="<%= csrf %>">
                    <input type="hidden" name="vid" value="<%= vol.id %>">
                    <select name="type" id="cert_type" onchange="toggleExpiry()" class="input-field">
                        <option value="internal">队内技能资质</option>
                        <option value="external">通用外部资质</option>
                    </select>
                    <input type="text" name="cert_name" placeholder="资质名称" required class="input-field">
                    <div><small style="color:#666; display:block; margin-bottom:5px;">签发/获取日期:</small><input type="date" name="issue_date" required class="input-field"></div>
                    <div id="expiry_div" style="display:none;"><small style="color:#dc3545; display:block; margin-bottom:5px;">有效截止日期:</small><input type="date" name="expiry_date" class="input-field"></div>
                    <div><small style="color:#666; display:block; margin-bottom:5px;">上传证书照片:</small><input type="file" name="cert_image" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="input-field" style="background:#fff;"></div>
                    <label style="display:flex; align-items:center; gap:8px; font-size:14px; color:#333;">
                        <input type="checkbox" name="show_on_dispatch" value="1">
                        在调度大屏人员详细信息窗口中显示此资质
                    </label>
                    <button type="submit" name="add_cert" value="1" class="btn" style="background:#0056b3; color:white; padding:12px; font-size:16px;">入档</button>
                </form>
            </div>
        </div>
        </div>
        <script>
        function toggleExpiry() { var type = document.getElementById('cert_type').value; document.getElementById('expiry_div').style.display = (type === 'external') ? 'block' : 'none'; }
        function switchAdminPane(id) {
            document.querySelectorAll('.admin-pane').forEach(function (el) { el.classList.toggle('active', el.id === id); });
            document.querySelectorAll('.admin-tab[data-pane]').forEach(function (el) { el.classList.toggle('active', el.getAttribute('data-pane') === id); });
        }
        document.querySelectorAll('.admin-tab[data-pane]').forEach(function (btn) {
            btn.addEventListener('click', function () { switchAdminPane(btn.getAttribute('data-pane')); });
        });
        if (location.hash === '#vol-certs') switchAdminPane('vol-certs');
        <% if (msg && String(msg).indexOf('资质') !== -1) { %>switchAdminPane('vol-certs');<% } %>
        </script>

    <% } else if (mode === 'edit_cert' && cert) { %>
        <div class="flex-header"><h2>✏️ 修改资质信息</h2><a href="?edit_id=<%= vid %>#vol-certs" class="btn" style="background:#6c757d; color:white;">返回档案</a></div>
        <div class="card" style="max-width:600px; margin:0 auto; border-top:4px solid #ffc107;">
            <form method="POST" enctype="multipart/form-data" style="display:flex; flex-direction:column; gap:15px;">
                <input type="hidden" name="csrf_token" value="<%= csrf %>">
                <input type="hidden" name="cert_id" value="<%= cert.id %>">
                <input type="hidden" name="vid" value="<%= vid %>">
                <input type="hidden" name="type" value="<%= type %>">
                <label style="font-weight:bold;">资质名称:</label><input type="text" name="cert_name" value="<%= cert.cert_name %>" required class="input-field">
                <label style="font-weight:bold;">签发/获取日期:</label><input type="date" name="issue_date" value="<%= cert.issue_date %>" required class="input-field">
                <% if (type === 'external') { %>
                <label style="font-weight:bold; color:#dc3545;">有效截止日期:</label><input type="date" name="expiry_date" value="<%= cert.expiry_date %>" required class="input-field">
                <% } %>
                <label style="display:flex; align-items:center; gap:8px; font-weight:bold; margin-top:4px;">
                    <input type="checkbox" name="show_on_dispatch" value="1" <%= cert.show_on_dispatch ? 'checked' : '' %>>
                    在调度大屏人员弹窗中显示此资质
                </label>
                <div style="border:1px dashed #ccc; border-radius:6px; padding:12px; background:#fafafa;">
                    <div style="font-weight:bold; margin-bottom:8px;">证书照片</div>
                    <% if (cert.image_url) { %>
                    <div style="margin-bottom:10px;">
                        <small style="color:#666; display:block; margin-bottom:6px;">当前照片：</small>
                        <a href="<%= cert.cert_src %>" target="_blank" rel="noopener">
                            <img src="<%= cert.cert_src %>"
                                 alt="当前证书"
                                 style="max-width:100%; max-height:220px; border-radius:4px; border:1px solid #e2e8f0; object-fit:contain; background:#fff;">
                        </a>
                    </div>
                    <% } else { %>
                    <p style="color:#999; font-size:13px; margin:0 0 10px;">当前无证书照片</p>
                    <% } %>
                    <small style="color:#666; display:block; margin-bottom:5px;">重新上传（可选）：</small>
                    <input type="file" name="cert_image" accept=".jpg,.jpeg,.png,image/jpeg,image/png" class="input-field" style="background:#fff;">
                    <small style="color:#94a3b8; display:block; margin-top:6px;">不上传文件则保留原图。</small>
                </div>
                <button type="submit" name="update_cert_info" value="1" class="btn" style="background:#ffc107; color:#333; padding:12px; font-size:16px;">💾 保存修改</button>
            </form>
        </div>

    <% } else if (mode === 'account' && vol) { %>
        <div class="flex-header"><h2>🔑 账号管理：<%= vol.name %></h2><a href="admin_edit.php?tab=people" class="btn" style="background:#6c757d; color:white;">返回列表</a></div>
        <div class="card" style="max-width:500px; margin:0 auto;">
            <% if (accountUser) { %>
                <form method="POST" style="display:flex; flex-direction:column; gap:15px;">
                    <input type="hidden" name="csrf_token" value="<%= csrf %>">
                    <input type="hidden" name="uid" value="<%= accountUser.id %>">
                    <input type="hidden" name="vid" value="<%= vol.id %>">
                    <label>登录账号:</label><input type="text" name="username" value="<%= accountUser.username %>" required class="input-field">
                    <label>权限:</label>
                    <select name="role" class="input-field">
                        <option value="user" <%= accountUser.role === 'user' ? 'selected' : '' %>>普通队员</option>
                        <option value="admin" <%= accountUser.role === 'admin' ? 'selected' : '' %>>管理员</option>
                    </select>
                    <label>重置密码:</label><input type="password" name="new_password" placeholder="留空则不更改；填写则须含大小写字母和数字" minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}" title="须含大写字母、小写字母和数字，至少 8 位" class="input-field">
                    <button type="submit" name="update_account" value="1" class="btn js-reauth" style="background:#0056b3; color:white; padding:12px;">保存更新</button>
                </form>
                <div style="margin-top:28px; padding-top:16px; border-top:1px solid #eee;">
                    <h3 style="margin:0 0 10px; font-size:16px;">双因素认证 (2FA)</h3>
                    <% if (accountUser.totp_enabled) { %>
                        <p style="margin:0 0 12px; color:#15803d; font-weight:700;">已开启</p>
                        <form method="POST" class="js-reauth-form">
                            <input type="hidden" name="csrf_token" value="<%= csrf %>">
                            <input type="hidden" name="uid" value="<%= accountUser.id %>">
                            <input type="hidden" name="vid" value="<%= vol.id %>">
                            <button type="submit" name="disable_2fa" value="1" class="btn" style="background:#dc3545; color:white;">关闭 2FA</button>
                        </form>
                    <% } else if (typeof showSetup !== 'undefined' && showSetup && totpQr) { %>
                        <p style="margin:0 0 10px; font-size:13px; color:#555;">用身份验证器扫描后输入动态码确认。</p>
                        <img src="<%= totpQr %>" alt="2FA QR" width="220" height="220" style="display:block; margin:0 auto 10px;">
                        <p style="font-family:monospace; font-size:13px; word-break:break-all; text-align:center;"><%= totpSecret %></p>
                        <form method="POST" style="display:flex; flex-direction:column; gap:10px; margin-top:12px;">
                            <input type="hidden" name="csrf_token" value="<%= csrf %>">
                            <input type="hidden" name="uid" value="<%= accountUser.id %>">
                            <input type="hidden" name="vid" value="<%= vol.id %>">
                            <input type="text" name="totp_setup" class="input-field" inputmode="numeric" autocomplete="one-time-code" maxlength="8" pattern="[0-9]{6,8}" placeholder="6 位动态码" required>
                            <button type="submit" name="confirm_2fa" value="1" class="btn" style="background:#28a745; color:white;">确认开启</button>
                        </form>
                        <form method="POST" style="margin-top:8px;">
                            <input type="hidden" name="csrf_token" value="<%= csrf %>">
                            <input type="hidden" name="uid" value="<%= accountUser.id %>">
                            <input type="hidden" name="vid" value="<%= vol.id %>">
                            <button type="submit" name="cancel_2fa_setup" value="1" class="btn" style="background:#6c757d; color:white;">取消</button>
                        </form>
                    <% } else { %>
                        <p style="margin:0 0 12px; color:#64748b; font-size:13px;">未开启</p>
                        <form method="POST">
                            <input type="hidden" name="csrf_token" value="<%= csrf %>">
                            <input type="hidden" name="uid" value="<%= accountUser.id %>">
                            <input type="hidden" name="vid" value="<%= vol.id %>">
                            <button type="submit" name="start_2fa" value="1" class="btn" style="background:#0056b3; color:white;">开启 2FA</button>
                        </form>
                    <% } %>
                </div>
            <% } else { %>
                <form method="POST" style="display:flex; flex-direction:column; gap:15px;">
                    <input type="hidden" name="csrf_token" value="<%= csrf %>">
                    <input type="hidden" name="vid" value="<%= vol.id %>">
                    <label>分配账号:</label><input type="text" name="username" required class="input-field">
                    <label>权限:</label>
                    <select name="role" class="input-field"><option value="user">普通队员</option><option value="admin">管理员</option></select>
                    <label>初始密码:</label><input type="password" name="password" required minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}" title="须含大写字母、小写字母和数字，至少 8 位" class="input-field">
                    <button type="submit" name="create_account" value="1" class="btn js-reauth" style="background:#28a745; color:white; padding:12px;">开通账号</button>
                </form>
            <% } %>
        </div>

    <% } else { %>
        <% var tab = (typeof listTab !== 'undefined' && listTab === 'cards') ? 'cards' : 'people'; %>
        <div class="flex-header"><h2>证件人员综合管理</h2><a href="dashboard.php" class="btn" style="background:#6c757d; color:white;">返回导航页</a></div>
        <nav class="admin-tabs" role="tablist">
            <a href="?tab=people" class="admin-tab <%= tab === 'people' ? 'active' : '' %>" data-pane="pane-people">队员档案<small><%= volunteers.length %> 人</small></a>
            <a href="?tab=cards" class="admin-tab <%= tab === 'cards' ? 'active' : '' %>" data-pane="pane-cards">实体证件<small><%= (idCards || []).length %> 张</small></a>
        </nav>

        <div id="pane-people" class="admin-pane <%= tab === 'people' ? 'active' : '' %>">
        <div class="card" style="background:#e9ecef; border-left:5px solid #0056b3;">
            <form method="POST" class="quick-add-form">
                <input type="hidden" name="csrf_token" value="<%= csrf %>">
                <strong>➕ 快速建档:</strong>
                <input type="text" name="new_name" placeholder="姓名" required class="input-field">
                <input type="text" name="new_badge" placeholder="编号" required class="input-field">
                <input type="date" name="new_join_date" required class="input-field">
                <button type="submit" name="add_volunteer" value="1" class="btn" style="background:#0056b3; color:white;">新建</button>
            </form>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <tr style="background:#0056b3; color:white;"><th>ID</th><th>姓名</th><th>编号</th><th>证件</th><th>分区</th><th>状态</th><th>操作</th></tr>
                <% volunteers.forEach(function(row) { %>
                <tr>
                    <td><%= row.id %></td>
                    <td><%= row.name %></td>
                    <td><%= row.badge_number %></td>
                    <td><%= row.id_card_no ? row.id_card_no : '—' %></td>
                    <td><%= row.agency ? row.agency : '—' %></td>
                    <td><%= row.status === 'active' ? '在职' : '离队' %></td>
                    <td>
                        <div class="btn-group">
                            <a href="?edit_id=<%= row.id %>" class="btn" style="border:1px solid #0056b3; color:#0056b3;">📝 档案</a>
                            <a href="?account_id=<%= row.id %>" class="btn" style="border:1px solid #28a745; color:#28a745;">🔑 账号</a>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </table>
        </div>
        </div>

        <div id="pane-cards" class="admin-pane <%= tab === 'cards' ? 'active' : '' %>">
        <div id="id-cards" class="card" style="border-top:4px solid #0056b3;">
            <h3 class="card-header">证件管理</h3>
            <p style="color:#666; font-size:13px; margin:0 0 16px;">请先在「系统设置 → 系统信息」填写证件扫码根地址扫描设备用于跳转的网址。<% if (typeof cardScanBase !== 'undefined' && cardScanBase) { %> 当前根地址：<code><%= cardScanBase %></code><% } else { %> <strong style="color:#b45309;">尚未填写根地址，扫描设备无法打开页面。</strong><% } %></p>
            <form method="POST" class="quick-add-form" style="margin-bottom:20px;">
                <input type="hidden" name="csrf_token" value="<%= csrf %>">
                <input type="text" name="new_card_no" placeholder="证件号" required maxlength="64" class="input-field">
                <input type="text" name="new_card_note" placeholder="备注（可选）" maxlength="255" class="input-field">
                <select name="new_card_vid" class="input-field">
                    <option value="">未绑定</option>
                    <% volunteers.forEach(function(v) { %>
                    <option value="<%= v.id %>"><%= v.name %>（<%= v.badge_number || ('ID ' + v.id) %>）</option>
                    <% }) %>
                </select>
                <button type="submit" name="add_id_card" value="1" class="btn" style="background:#0056b3; color:white;">添加证件</button>
            </form>
            <div class="table-responsive">
                <table class="admin-table">
                    <tr style="background:#343a40; color:white;"><th>证件号</th><th>备注 / 绑定</th><th>状态</th><th>操作</th></tr>
                    <% (idCards || []).forEach(function(c) { %>
                    <tr>
                        <td>
                            <strong><%= c.card_no %></strong>
                            <% if (c.volunteer_name) { %>
                            <div style="font-size:12px; color:#666; margin-top:4px;"><%= c.volunteer_name %></div>
                            <% } %>
                        </td>
                        <td>
                            <form method="POST" class="id-card-row-form">
                                <input type="hidden" name="csrf_token" value="<%= csrf %>">
                                <input type="hidden" name="card_id" value="<%= c.id %>">
                                <input type="text" name="card_note" value="<%= c.note || '' %>" placeholder="备注" maxlength="255" class="input-field">
                                <select name="card_vid" class="input-field">
                                    <option value="" <%= !c.volunteer_id ? 'selected' : '' %>>未绑定</option>
                                    <% volunteers.forEach(function(v) { %>
                                    <option value="<%= v.id %>" <%= Number(c.volunteer_id) === Number(v.id) ? 'selected' : '' %>><%= v.name %>（<%= v.badge_number || ('ID ' + v.id) %>）</option>
                                    <% }) %>
                                </select>
                                <button type="submit" name="save_id_card" value="1" class="btn" style="background:#28a745; color:white;">保存</button>
                            </form>
                        </td>
                        <td>
                            <% if (c.status === 'lost') { %>
                            <span class="id-badge id-badge-lost">挂失</span>
                            <% } else if (c.status === 'bound') { %>
                            <span class="id-badge id-badge-bound">已绑定</span>
                            <% } else { %>
                            <span class="id-badge id-badge-unbound">未绑定</span>
                            <% } %>
                        </td>
                        <td>
                            <div class="btn-group">
                                <button type="button" class="btn js-qr"
                                    style="border:1px solid #0056b3; color:#0056b3;"
                                    data-no="<%= c.card_no %>"
                                    data-bind="<%= c.volunteer_name || '未绑定' %>"
                                    data-url="<%= c.scanUrl || '' %>"
                                    data-img="<%= c.qrDataUri || '' %>">二维码</button>
                                <% if (c.status === 'lost') { %>
                                <form method="POST" style="display:inline;">
                                    <input type="hidden" name="csrf_token" value="<%= csrf %>">
                                    <input type="hidden" name="card_id" value="<%= c.id %>">
                                    <button type="submit" name="restore_id_card" value="1" class="btn" style="background:#6c757d; color:white;">解挂</button>
                                </form>
                                <% } else { %>
                                <form method="POST" style="display:inline;" onsubmit="return confirm('挂失后扫码只显示证件号与挂失提示，绑定关系仍保留。确定挂失？')">
                                    <input type="hidden" name="csrf_token" value="<%= csrf %>">
                                    <input type="hidden" name="card_id" value="<%= c.id %>">
                                    <button type="submit" name="lose_id_card" value="1" class="btn" style="background:#ffc107; color:#333;">挂失</button>
                                </form>
                                <% } %>
                                <form method="POST" style="display:inline;" class="js-reauth-form">
                                    <input type="hidden" name="csrf_token" value="<%= csrf %>">
                                    <input type="hidden" name="card_id" value="<%= c.id %>">
                                    <button type="submit" name="delete_id_card" value="1" class="btn" style="background:#dc3545; color:white;">删除</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <% }) %>
                    <% if (!(idCards || []).length) { %>
                    <tr><td colspan="4" style="color:#888; text-align:center;">暂无证件，请先添加。</td></tr>
                    <% } %>
                </table>
            </div>
        </div>
        </div>
        <div id="qrModal" class="qr-modal" onclick="if(event.target===this) closeQrModal()">
            <div class="qr-box">
                <h3 style="margin:0 0 8px;">证件二维码</h3>
                <p id="qrMeta" style="margin:0 0 12px; color:#555; font-size:14px;"></p>
                <img id="qrImg" alt="证件二维码" width="240" height="240" style="width:240px;height:240px;background:#fff;display:inline-block;">
                <p id="qrUrl" style="word-break:break-all; font-size:12px; color:#666; margin:12px 0;"></p>
                <div class="qr-actions btn-group" style="justify-content:center;">
                    <button type="button" class="btn" style="background:#0056b3; color:white;" onclick="window.print()">打印</button>
                    <button type="button" class="btn" style="background:#6c757d; color:white;" onclick="closeQrModal()">关闭</button>
                </div>
            </div>
        </div>
        <script>
        function closeQrModal() {
            var m = document.getElementById('qrModal');
            if (m) m.classList.remove('show');
        }
        function switchAdminPane(id) {
            document.querySelectorAll('.admin-pane').forEach(function (el) { el.classList.toggle('active', el.id === id); });
            document.querySelectorAll('.admin-tab[data-pane]').forEach(function (el) { el.classList.toggle('active', el.getAttribute('data-pane') === id); });
            var tab = id === 'pane-cards' ? 'cards' : 'people';
            try {
                var u = new URL(location.href);
                u.searchParams.set('tab', tab);
                if (history.replaceState) history.replaceState(null, '', u.pathname + u.search);
            } catch (e) {}
        }
        document.querySelectorAll('.admin-tab[data-pane]').forEach(function (el) {
            el.addEventListener('click', function (e) {
                e.preventDefault();
                switchAdminPane(el.getAttribute('data-pane'));
            });
        });
        if (location.hash === '#id-cards') switchAdminPane('pane-cards');
        document.querySelectorAll('.js-qr').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var url = btn.getAttribute('data-url') || '';
                var no = btn.getAttribute('data-no') || '';
                var bind = btn.getAttribute('data-bind') || '';
                document.getElementById('qrMeta').textContent = '证件号 ' + no + ' · 当前绑定：' + bind;
                document.getElementById('qrUrl').textContent = url;
                var img = document.getElementById('qrImg');
                var dataImg = btn.getAttribute('data-img') || '';
                img.alt = '证件 ' + no;
                img.onerror = function () {
                    document.getElementById('qrUrl').textContent = '二维码生成失败。请复制：' + url;
                };
                if (dataImg) {
                    img.src = dataImg;
                } else {
                    img.src = '/id_card_qr.php?no=' + encodeURIComponent(no);
                }
                document.getElementById('qrModal').classList.add('show');
            });
        });
        </script>
    <% } %>
    <div id="reauthModal" class="qr-modal">
        <div class="qr-box" style="text-align:left; max-width:400px;">
            <h3 style="margin:0 0 8px;">二次授权</h3>
            <p id="reauthHint" style="font-size:13px; color:#64748b; margin:0 0 12px;"></p>
            <label style="font-size:13px;">当前账号密码</label>
            <input type="password" id="reauthPass" class="input-field" autocomplete="current-password">
            <div id="reauthTotpWrap" style="display:none; margin-top:10px;">
                <label style="font-size:13px;">动态验证码</label>
                <input type="text" id="reauthTotp" class="input-field" inputmode="numeric" autocomplete="one-time-code" maxlength="8">
            </div>
            <p id="reauthErr" style="display:none; color:#dc3545; font-size:13px; margin:10px 0 0;"></p>
            <div class="btn-group" style="margin-top:16px;">
                <button type="button" class="btn" id="reauthCancel" style="background:#6c757d; color:#fff;">取消</button>
                <button type="button" class="btn" id="reauthOk" style="background:#0056b3; color:#fff;">确认</button>
            </div>
        </div>
    </div>
    <script>
    (function () {
        var has2fa = <%= (typeof actorHas2fa !== 'undefined' && actorHas2fa) ? 'true' : 'false' %>;
        var pendingForm = null;
        var modal = document.getElementById('reauthModal');
        var passEl = document.getElementById('reauthPass');
        var totpEl = document.getElementById('reauthTotp');
        var totpWrap = document.getElementById('reauthTotpWrap');
        var hint = document.getElementById('reauthHint');
        var errEl = document.getElementById('reauthErr');
        function openReauth(form) {
            pendingForm = form;
            errEl.style.display = 'none';
            passEl.value = '';
            totpEl.value = '';
            totpWrap.style.display = has2fa ? 'block' : 'none';
            hint.textContent = has2fa ? '需要密码和动态验证码。' : '需要输入当前账号密码。';
            modal.classList.add('show');
            passEl.focus();
        }
        function closeReauth() {
            modal.classList.remove('show');
            pendingForm = null;
        }
        function attach(form) {
            form.addEventListener('submit', function (e) {
                if (form.getAttribute('data-reauth-ok') === '1') return;
                e.preventDefault();
                openReauth(form);
            });
        }
        document.querySelectorAll('form.js-reauth-form').forEach(attach);
        document.querySelectorAll('button.js-reauth').forEach(function (btn) {
            var form = btn.closest('form');
            if (form && !form.classList.contains('js-reauth-form')) {
                form.classList.add('js-reauth-form');
                attach(form);
            }
        });
        document.getElementById('reauthCancel').addEventListener('click', closeReauth);
        modal.addEventListener('click', function (e) { if (e.target === modal) closeReauth(); });
        document.getElementById('reauthOk').addEventListener('click', function () {
            if (!pendingForm) return;
            if (!passEl.value) {
                errEl.textContent = '请输入密码';
                errEl.style.display = 'block';
                return;
            }
            if (has2fa && !totpEl.value) {
                errEl.textContent = '请输入动态验证码';
                errEl.style.display = 'block';
                return;
            }
            function setHidden(name, value) {
                var el = pendingForm.querySelector('input[name="' + name + '"]');
                if (!el) {
                    el = document.createElement('input');
                    el.type = 'hidden';
                    el.name = name;
                    pendingForm.appendChild(el);
                }
                el.value = value;
            }
            setHidden('confirm_password', passEl.value);
            if (has2fa) setHidden('confirm_totp', totpEl.value);
            pendingForm.setAttribute('data-reauth-ok', '1');
            pendingForm.submit();
        });
    })();
    </script>
</main>
<%- include('partials/footer') %>
