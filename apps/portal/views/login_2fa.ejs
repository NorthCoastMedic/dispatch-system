<%- include('partials/header') %>
<style>
    body { background-color: var(--bg-color, #f4f7f6); }
    .login-wrapper { display: flex; justify-content: center; align-items: center; min-height: 75vh; }
    .login-card { background: var(--white, #fff); padding: 40px; border-radius: 12px; box-shadow: 0 10px 30px var(--pt-shadow, rgba(0,0,0,0.08)); width: 100%; max-width: 400px; text-align: center; }
    .login-card h2 { color: var(--pt-accent, #0056b3); margin-bottom: 12px; font-weight: bold; letter-spacing: 1px; }
    .login-card p { color: var(--pt-muted, #666); font-size: 14px; margin: 0 0 24px; }
    .login-input { width: 100%; padding: 15px; margin-bottom: 20px; border: 1px solid var(--pt-border, #ddd); border-radius: 8px; font-size: 15px; box-sizing: border-box; outline: none; letter-spacing: 6px; text-align: center; }
    .login-btn { width: 100%; padding: 15px; background: var(--primary-color, #0056b3); color: white; border: none; border-radius: 8px; font-size: 16px; font-weight: bold; cursor: pointer; }
    .error-msg { background: #ffe6e6; color: #dc3545; padding: 10px; border-radius: 6px; margin-bottom: 20px; font-size: 14px; }
</style>
<div class="login-wrapper">
    <div class="login-card">
        <h2>双因素认证</h2>
        <p>账号 <%= username %> 已开启 2FA</p>
        <% if (error) { %><div class="error-msg">✖ <%= error %></div><% } %>
        <form method="POST" action="/login_2fa.php">
            <% if (typeof redirect !== 'undefined' && redirect) { %>
            <input type="hidden" name="redirect" value="<%= redirect %>">
            <% } %>
            <input type="text" name="totp" class="login-input" placeholder="6 位动态码" inputmode="numeric" autocomplete="one-time-code" required maxlength="8" pattern="[0-9]{6,8}">
            <button type="submit" class="login-btn">确认登录</button>
        </form>
    </div>
</div>
<%- include('partials/footer') %>
