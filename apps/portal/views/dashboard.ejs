<%- include('partials/header') %>
<style>
    .dash { display: flex; flex-direction: column; flex: 1; min-height: 0; padding: 0; background: var(--pt-bg, #eef1f4); }
    .dbody { flex: 1; min-height: 0; overflow: auto; padding: 12px 14px; }
    .dsec { font-size: 13px; font-weight: bold; color: var(--pt-text-2, #33475f); margin: 4px 0 8px; }
    .dsec span { font-weight: normal; color: var(--pt-muted, #7b8794); margin-left: 8px; }
    .tbl { width: 100%; border-collapse: collapse; background: var(--pt-panel, #fff); border: 1px solid var(--pt-border-soft, #b9c1ca); }
    .tbl th { background: var(--pt-panel-2, #e6eaef); border: 1px solid var(--pt-border, #c8cfd7); padding: 8px 12px; text-align: left; font-size: 13px; color: var(--pt-text, #2b3b52); white-space: nowrap; }
    .tbl td { border: 1px solid var(--pt-border, #dde2e8); padding: 9px 12px; vertical-align: middle; color: var(--pt-text, #1e293b); }
    .tbl tr:hover td { background: var(--pt-hover, #f2f7fd); }
    .tbl .nm { font-weight: bold; color: var(--pt-accent, #0b4da2); font-size: 14px; }
    .tbl .ds { color: var(--pt-muted, #556070); font-size: 13px; }
    .tbl .st { white-space: nowrap; font-size: 13px; color: var(--pt-text-2, #33475f); }
    .tbl .st i { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #22a04a; margin-right: 6px; }
    .tbl .ent a { display: inline-block; border: 1px solid var(--pt-border-soft, #9aa3ad); background: var(--pt-panel-2, #f1f3f5); padding: 3px 14px; color: var(--pt-accent, #0b4da2); text-decoration: none; font-size: 13px; }
    .tbl .ent a:hover { background: var(--pt-hover, #e2e7ec); }
    .dmob { display: none; }
    @media (max-width: 900px) {
        .dash { flex: 1; min-height: 0; overflow: hidden; }
        .dbody { display: none; }
        .dmob { flex: 1; display: flex; flex-direction: column; gap: 8px; padding: 10px 12px; overflow: hidden; }
        .dmob .dsec { margin: 0; }
        .mgrp { flex: 1; min-height: 0; display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: 1fr; border-top: 1px solid var(--pt-border-soft, #b9c1ca); border-left: 1px solid var(--pt-border-soft, #b9c1ca); background: var(--pt-panel, #fff); }
        .mblk { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 12px; border-right: 1px solid var(--pt-border, #c8cfd7); border-bottom: 1px solid var(--pt-border, #c8cfd7); color: var(--pt-accent, #0b4da2); font-weight: bold; font-size: 15px; text-decoration: none; }
        .mblk:active { background: var(--pt-hover, #eef4fb); }
        .mblk i { flex: none; width: 9px; height: 9px; border-radius: 50%; background: #22a04a; }
    }
    @media (max-width: 400px) { .mblk { font-size: 14px; padding: 10px; } }
</style>
<%
var items = (navItems || []).filter(function (it) {
    if (!it || it.enabled === false) return false;
    if (it.admin_only && user.role !== 'admin') return false;
    return true;
});
var normal = items.filter(function (it) { return !it.admin_only; });
var admins = items.filter(function (it) { return it.admin_only; });
%>
<main class="dash">
    <div class="dbody">
        <div class="dsec">系统功能<span>全体成员可用</span></div>
        <table class="tbl">
            <tr><th style="width:200px">功能名称</th><th>说明</th><th style="width:110px">状态</th><th style="width:110px">操作</th></tr>
            <% normal.forEach(function (it) { %>
            <tr>
                <td class="nm"><%= it.title %></td>
                <td class="ds"><%= it.desc || '' %></td>
                <td class="st"><i></i>运行中</td>
                <td class="ent"><a href="<%= it.href %>"<% if (it.target === '_blank') { %> target="_blank" rel="noopener noreferrer"<% } %>>进入</a></td>
            </tr>
            <% }) %>
        </table>
        <% if (admins.length) { %>
        <div class="dsec" style="margin-top:14px">管理功能<span>仅管理员可用</span></div>
        <table class="tbl">
            <tr><th style="width:200px">功能名称</th><th>说明</th><th style="width:110px">状态</th><th style="width:110px">操作</th></tr>
            <% admins.forEach(function (it) { %>
            <tr>
                <td class="nm"><%= it.title %></td>
                <td class="ds"><%= it.desc || '' %></td>
                <td class="st"><i></i>可用</td>
                <td class="ent"><a href="<%= it.href %>"<% if (it.target === '_blank') { %> target="_blank" rel="noopener noreferrer"<% } %>>进入</a></td>
            </tr>
            <% }) %>
        </table>
        <% } %>
    </div>
    <div class="dmob">
        <div class="dsec">系统功能 · 全体可用</div>
        <div class="mgrp">
            <% normal.forEach(function (it) { %>
            <a class="mblk" href="<%= it.href %>"<% if (it.target === '_blank') { %> target="_blank" rel="noopener noreferrer"<% } %>><span><%= it.title %></span><i></i></a>
            <% }) %>
        </div>
        <% if (admins.length) { %>
        <div class="dsec">管理功能 · 仅管理员</div>
        <div class="mgrp">
            <% admins.forEach(function (it) { %>
            <a class="mblk" href="<%= it.href %>"<% if (it.target === '_blank') { %> target="_blank" rel="noopener noreferrer"<% } %>><span><%= it.title %></span><i></i></a>
            <% }) %>
        </div>
        <% } %>
    </div>
</main>
<script>
(function () {
    var pad = function (n) { return String(n).padStart(2, '0'); };
    var clk = document.getElementById('clk'), dt = document.getElementById('dt');
    var W = ['日', '一', '二', '三', '四', '五', '六'];
    function tick() {
        var d = new Date();
        clk.textContent = pad(d.getHours()) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds());
        dt.textContent = d.getFullYear() + '/' + pad(d.getMonth() + 1) + '/' + pad(d.getDate());
    }
    tick(); setInterval(tick, 1000);
    var wx = document.getElementById('wx');
    var FB = { name: '大连', lat: 38.914, lon: 121.615 };
    var CODE = { 0: '晴', 1: '多云', 2: '多云', 3: '阴', 45: '雾', 61: '小雨', 63: '中雨', 65: '大雨', 71: '小雪', 73: '中雪', 75: '大雪', 80: '阵雨', 82: '强阵雨', 95: '雷阵雨' };
    function load(lat, lon, name) {
        fetch('https://api.open-meteo.com/v1/forecast?latitude=' + lat + '&longitude=' + lon + '&current=temperature_2m,weather_code&timezone=auto', { cache: 'no-store' })
            .then(function (r) { return r.json(); })
            .then(function (j) {
                var c = j && j.current;
                if (!c || c.temperature_2m == null) throw 0;
                wx.textContent = '天气：' + name + ' ' + Math.round(c.temperature_2m) + '° ' + (CODE[c.weather_code] || '');
            })
            .catch(function () { wx.textContent = '天气：' + name + ' 不可用'; });
    }
    function start() {
        if (!navigator.geolocation) { load(FB.lat, FB.lon, FB.name); return; }
        navigator.geolocation.getCurrentPosition(function (p) {
            load(p.coords.latitude, p.coords.longitude, '当前位置');
        }, function () { load(FB.lat, FB.lon, FB.name); }, { timeout: 8000, maximumAge: 600000 });
    }
    start(); setInterval(start, 1800000);
})();
</script>
<%- include('partials/footer') %>
