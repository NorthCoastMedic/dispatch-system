# 统一组织系统 — 根配置
# 首次安装时由安装页自动写入本文件；也可复制为 .env 后手工填写。
# 注意：SESSION_SECRET 必须是至少 16 位强随机串（如 openssl rand -hex 32），
#      未配置或仍为示例值时，服务会拒绝进入业务模式。

PORT=12000
SESSION_SECRET=

# 走反向代理（nginx / caddy / 云反代）时设为 1，否则登录 Cookie 可能异常
TRUST_PROXY=0

# 访问令牌 / 刷新令牌有效期（秒）
TOKEN_ACCESS_TTL_SEC=900
TOKEN_REFRESH_TTL_SEC=86400

# 证件图片签名链接有效期（秒）
CERT_URL_TTL_SEC=1800
